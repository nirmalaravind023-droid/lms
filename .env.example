# Development only. Production must set DEBUG=False and provide a unique SECRET_KEY.
DEBUG=True
SECRET_KEY=replace-with-a-unique-development-secret

# Comma-separated hosts and complete trusted origins.
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Production security. Keep local development permissive; tighten these in deployments.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
X_FRAME_OPTIONS=DENY

# Use sqlite locally. Any other value enables the PostgreSQL configuration below.
DATABASE_ENGINE=sqlite

# PostgreSQL connection values, used when DATABASE_ENGINE is not sqlite.
POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional Redis-backed Django Channels layer.
REDIS_URL=redis://127.0.0.1:6379/0

# Display and email defaults.
COMPANY_NAME=Acme Learning
DEFAULT_FROM_EMAIL=noreply@example.com
